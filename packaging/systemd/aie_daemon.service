[Unit]
Description=AIE-OS AI Scheduler Daemon
Documentation=man:aie_daemon(8)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/aie_daemon
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aie_daemon

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/sys/kernel/debug /sys/kernel/btf

# Capabilities for eBPF/BPF map access
AmbientCapabilities=CAP_BPF CAP_PERFMON

[Install]
WantedBy=multi-user.target
